# Engine settings (all optional; /lotnok sets token, key and treasury)
PORT=5023
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The cycle: escrow size (ETH) that triggers each step, in order feeding (reward) → keeper (treasury) → feeding …
# There is no buyback and no burn step.
FEEDING_ETH=0.02
KEEPER_ETH=0.025
# Feedings go to this many sitters, biggest balances first, split by balance
FEEDING_TOP_N=10
# Tiers inside the top N, "upTo:percent": No. 1–5 share 70% (0.014 ETH), No. 6–10 share 30% (0.006), by balance within each
FEEDING_TIERS=5:70,10:30
MIN_BALANCE=100000
# First $RAFT must be this old (hours) to be fed; stops buying in right before a claim
MIN_HOLD_HOURS=0
CONTRACTS_ARE_SELLS=1
# extra sell destinations, comma separated (e.g. the Uniswap v4 PoolManager after graduation)
SELL_SINKS=
# needed only to change token/key/treasury after they are set
ADMIN_SECRET=
# Connect X (optional). An X developer app, type "Web App", callback <SITE_URL>/api/x/callback.
# Leave empty and the "Connect X" button stays hidden.
SITE_URL=https://your-domain.example
X_CLIENT_ID=
X_CLIENT_SECRET=
# 1 lets the demo edition try a real X sign-in (nothing saved). scripts/site-mode.sh sets it.
X_DEMO=0

# How often the engine reads new blocks (seconds). 3 keeps the Ladder live.
POLL_INTERVAL_SECONDS=3
